# 1. 复制：有选中文字时复制，没选中时作为一般中断/取消信号
keybind = performable:ctrl+c=copy_to_clipboard

# 2. 粘贴：直接使用 Ctrl+V 粘贴剪贴板内容
keybind = ctrl+v=paste_from_clipboard

# 3. 强制取消：设置 Ctrl+Shift+C 永远为发送中断信号 (SIGINT)
keybind = ctrl+shift+c=text:\x03

font-family = ""
# font-family = "Droid Sans Mono for Powerline Regular"
font-size = 11.5

# 隐藏系统的窗口装饰（彻底去掉顶栏和边框，最省空间）
window-decoration = false
# window-decoration = titlebar-only
theme = 0x96f

# 开启鼠标报告支持（默认其实是 true，但显式声明可以确保它强制开启）
# 如果你的鼠标偶现卡死在 tmux 某种特定点击状态（如右键残留），
# 可以确保这个值是 true。
mouse-reporting = true